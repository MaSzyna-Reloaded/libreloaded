; Generated by CMake into libreloaded.gdextension (CMakeLists.txt): the plugins of
; LIBRELOADED_PLUGINS add what they ship beside the library to [dependencies]

[configuration]

entry_symbol = "libreloaded_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

macos.debug = "res://bin/libreloaded/macos/libreloaded.debug.framework"
macos.release = "res://bin/libreloaded/macos/libreloaded.framework"
ios.debug = "res://bin/libreloaded/ios/libreloaded.debug.framework"
ios.release = "res://bin/libreloaded/ios/libreloaded.framework"
windows.debug.x86_32 = "res://bin/libreloaded/windows/libreloaded.debug.dll"
windows.release.x86_32 = "res://bin/libreloaded/windows/libreloaded.dll"
windows.debug.x86_64 = "res://bin/libreloaded/windows/libreloaded.debug.64.dll"
windows.release.x86_64 = "res://bin/libreloaded/windows/libreloaded.64.dll"
linux.debug.x86_64 = "res://bin/libreloaded/linux/libreloaded.debug.64.so"
linux.release.x86_64 = "res://bin/libreloaded/linux/libreloaded.64.so"
linux.debug.arm64 = "res://bin/libreloaded/linux/libreloaded.debug.arm64.so"
linux.release.arm64 = "res://bin/libreloaded/linux/libreloaded.arm64.so"
linux.debug.rv64 = "res://bin/libreloaded/linux/libreloaded.debug.rv64.so"
linux.release.rv64 = "res://bin/libreloaded/linux/libreloaded.rv64.so"
android.debug.x86_64 = "res://bin/libreloaded/android/libreloaded.debug.64.so"
android.release.x86_64 = "res://bin/libreloaded/android/libreloaded.64.so"
android.debug.arm64 = "res://bin/libreloaded/android/libreloaded.debug.arm64.so"
android.release.arm64 = "res://bin/libreloaded/android/libreloaded.arm64.so"

[dependencies]

@RELOADED_PLUGIN_DEPENDENCIES@
