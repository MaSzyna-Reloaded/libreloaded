<?xml version="1.0" encoding="UTF-8" ?>
<class name="SignalBoxData" inherits="Resource" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		A signal box of a world.
	</brief_description>
	<description>
		OSM's railway=signal_box: its name, its code, its kind, where it is and the station it works for.
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="box_name" type="String" setter="set_box_name" getter="get_box_name" default="&quot;&quot;">
			Its name.
		</member>
		<member name="kind" type="String" setter="set_kind" getter="get_kind" default="&quot;&quot;">
			Its kind (OSM's railway:signal_box, e.g. "electronic", "relay", "mechanical").
		</member>
		<member name="lat_lon" type="Vector2" setter="set_lat_lon" getter="get_lat_lon" default="Vector2(0, 0)">
			Latitude and longitude, degrees.
		</member>
		<member name="position" type="Vector3" setter="set_position" getter="get_position" default="Vector3(0, 0, 0)">
			Its place in the world, on the ground.
		</member>
		<member name="ref" type="String" setter="set_ref" getter="get_ref" default="&quot;&quot;">
			Its code (OSM's railway:ref, e.g. "Tz").
		</member>
		<member name="station_ref" type="String" setter="set_station_ref" getter="get_station_ref" default="&quot;&quot;">
			The ref of the station it works for ([member StationData.ref]): by its own code, else the nearest's.
		</member>
	</members>
</class>
