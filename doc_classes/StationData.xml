<?xml version="1.0" encoding="UTF-8" ?>
<class name="StationData" inherits="Resource" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		A station or a halt of a world.
	</brief_description>
	<description>
		OSM's railway=station|halt, for a list of the world's stations: its name, the codes it is known by and where it is.
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="lat_lon" type="Vector2" setter="set_lat_lon" getter="get_lat_lon" default="Vector2(0, 0)">
			Latitude and longitude, degrees.
		</member>
		<member name="position" type="Vector3" setter="set_position" getter="get_position" default="Vector3(0, 0, 0)">
			Its place in the world, on the ground.
		</member>
		<member name="ref" type="String" setter="set_ref" getter="get_ref" default="&quot;&quot;">
			Its code in the signalling and the timetables (OSM's railway:ref, e.g. "Tz").
		</member>
		<member name="station_name" type="String" setter="set_station_name" getter="get_station_name" default="&quot;&quot;">
			Its name.
		</member>
		<member name="uic_ref" type="String" setter="set_uic_ref" getter="get_uic_ref" default="&quot;&quot;">
			Its UIC code (OSM's uic_ref, e.g. "5100072").
		</member>
	</members>
</class>
