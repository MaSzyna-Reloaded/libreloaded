+void RendererSceneCull::instance_light_set_shadow_cascade_anchor(RID p_instance, const Vector3 &p_origin, bool p_enabled) {
+	Instance *instance = instance_owner.get_or_null(p_instance);
+	ERR_FAIL_NULL(instance);
+	ERR_FAIL_COND(instance->base_type != RSE::INSTANCE_LIGHT);
+
+	InstanceLightData *light = static_cast<InstanceLightData *>(instance->base_data);
+	if (light->shadow_cascade_anchor_enabled != p_enabled) {
+		// The snap centers already stored are relative to whichever anchor (or lack of one) was in
+		// effect when they were last set - turning the anchor on or off changes what they are
+		// relative to, so none of them are still valid. One clean recenter, same as any other cause.
+		for (int i = 0; i < 4; i++) {
+			light->shadow_cascade_snap_valid[i] = false;
+		}
+	}
+	light->shadow_cascade_anchor_origin = p_origin;
+	light->shadow_cascade_anchor_enabled = p_enabled;
+}
