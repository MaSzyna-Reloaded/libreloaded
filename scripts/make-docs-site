#!/usr/bin/env python3
"""Assemble the Jekyll site of libreloaded and the plugins built into it (make docs-site).

The site is libreloaded's docs/ with each plugin's guides beside it: the plugin's docs/ (its pages
and assets, without its own _config.yml) goes into <site dir>/<plugin name>/, and the pages its
docs/_config.yml lists under header_pages join the site's menu after libreloaded's, as
<plugin name>/<page>. A plugin's page links libreloaded's pages and the class reference relatively
(`../architecture.html`, `../api/VehicleServer.html`). The class reference of every source is
generated into <site dir>/api by scripts/make-api-docs. The plugins are LIBRELOADED_PLUGINS, as
the library is built with them (scripts/reloaded_sources.py), so the site documents what that
build holds. The site is generated, not versioned.

Usage: scripts/make-docs-site <site dir>
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

from reloaded_sources import ROOT, sources

# what Jekyll or a local install leaves in docs/, and docs/Makefile - never part of the site
IGNORED = shutil.ignore_patterns("_site", ".jekyll-cache", ".jekyll-metadata", ".sass-cache", "vendor", "api",
                                 "Makefile")
# what of a plugin's docs/ is not its pages: the site's configuration and machinery are libreloaded's
PLUGIN_IGNORED = shutil.ignore_patterns("_config.yml", "_layouts", "_includes", "Gemfile", "Gemfile.lock",
                                        "Makefile", "404.html", ".bundle", ".gitignore", "_site",
                                        ".jekyll-cache", "vendor", "api")


def header_pages(config_text: str) -> list:
    """header_pages of a _config.yml, as listed"""
    pages, listing = [], False
    for line in config_text.splitlines():
        if line.startswith("header_pages:"):
            listing = True
        elif listing and line.strip().startswith("- "):
            pages.append(line.strip()[2:].strip())
        elif listing and line.strip():
            listing = False
    return pages


def with_header_pages(config_text: str, pages: list) -> str:
    """The _config.yml with its header_pages replaced by `pages`"""
    out, listing = [], False
    for line in config_text.splitlines():
        if line.startswith("header_pages:"):
            listing = True
            out.append(line)
            out.extend(f"  - {page}" for page in pages)
            continue
        if listing and (line.strip().startswith("- ") or not line.strip()):
            if not line.strip():
                listing = False
                out.append(line)
            continue
        listing = False
        out.append(line)
    return "\n".join(out) + "\n"


def main() -> None:
    if not len(sys.argv) == 2:
        sys.exit(__doc__)
    site = Path(sys.argv[1]).resolve()
    core, *plugins = sources()
    if site.exists():
        shutil.rmtree(site)
    shutil.copytree(core.docs_dir, site, ignore=IGNORED)
    config = site / "_config.yml"
    menu = header_pages(config.read_text())
    for plugin in plugins:
        if not plugin.docs_dir.is_dir():
            continue
        shutil.copytree(plugin.docs_dir, site / plugin.name, ignore=PLUGIN_IGNORED)
        plugin_config = plugin.docs_dir / "_config.yml"
        if plugin_config.exists():
            menu += [f"{plugin.name}/{page}" for page in header_pages(plugin_config.read_text())]
    config.write_text(with_header_pages(config.read_text(), menu))
    subprocess.run([sys.executable, str(ROOT / "scripts" / "make-api-docs"), str(site / "api")],
                   check=True, env=os.environ)
    print(f"{site}: libreloaded" + "".join(f" + {plugin.name}" for plugin in plugins))


if __name__ == "__main__":
    main()
