#!/usr/bin/env python3
"""Assemble the Jekyll site of one source - libreloaded or a plugin built into it (make docs-site).

The site is the source's docs/ - its pages, assets and _config.yml, which gives the site's title,
description and menu (header_pages) - on libreloaded's site machinery (its layouts, includes,
Gemfile and 404 page), with the class reference of every source generated into <site dir>/api by
scripts/make-api-docs. A plugin's page links libreloaded's guides on libreloaded's own site
(https://maszyna-reloaded.github.io/libreloaded/). The sources are libreloaded and
LIBRELOADED_PLUGINS, as the library is built with them (scripts/reloaded_sources.py), so the
reference documents what that build holds. The site is generated, not versioned.

Usage: scripts/make-docs-site <site dir> [<source name>]   (libreloaded when left out)
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

from reloaded_sources import ROOT, sources

# what Jekyll or a local install leaves in docs/, docs/Makefile and the findings (the repository's
# record behind FINDINGS.md, not a guide) - never part of the site
IGNORED = shutil.ignore_patterns("_site", ".jekyll-cache", ".jekyll-metadata", ".sass-cache", "vendor", "api",
                                 "Makefile", "findings-archive.md")
# libreloaded's docs/ that is the machinery of every site, not its pages
MACHINERY = ("_layouts", "_includes", "Gemfile", "Gemfile.lock", "404.html", ".bundle")


def main() -> None:
    if not len(sys.argv) in (2, 3):
        sys.exit(__doc__)
    site = Path(sys.argv[1]).resolve()
    name = sys.argv[2] if len(sys.argv) == 3 else "libreloaded"
    core, *plugins = sources()
    documented = next((source for source in (core, *plugins) if source.name == name), None)
    if documented is None:
        sys.exit(f"{name}: neither libreloaded nor a plugin of LIBRELOADED_PLUGINS")
    if site.exists():
        shutil.rmtree(site)
    shutil.copytree(documented.docs_dir, site, ignore=IGNORED)
    if documented is not core:
        for entry in MACHINERY:
            source = core.docs_dir / entry
            if source.is_dir():
                shutil.copytree(source, site / entry, dirs_exist_ok=True)
            else:
                shutil.copy2(source, site / entry)
    subprocess.run([sys.executable, str(ROOT / "scripts" / "make-api-docs"), str(site / "api")],
                   check=True, env=os.environ)
    print(f"{site}: {name}, the class reference of libreloaded" + "".join(f" + {plugin.name}" for plugin in plugins))


if __name__ == "__main__":
    main()
