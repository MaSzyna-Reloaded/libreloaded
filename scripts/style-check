#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLANG_TIDY_BUILD_DIR="${ROOT_DIR}/build-clang-tidy"

usage() {
    echo "Usage: scripts/style-check [path/to/file]" >&2
}

ensure_compile_commands() {
    local plugins
    plugins="$(plugin_dirs | paste -sd ';')"
    local configured=""
    if [ -f "${CLANG_TIDY_BUILD_DIR}/CMakeCache.txt" ]; then
        configured="$(sed -n 's/^LIBRELOADED_PLUGINS:STRING=//p' "${CLANG_TIDY_BUILD_DIR}/CMakeCache.txt")"
    fi
    if [ "${configured}" != "${plugins}" ] || \
        [ ! -f "${CLANG_TIDY_BUILD_DIR}/compile_commands.json" ] || \
        [ ! -f "${CLANG_TIDY_BUILD_DIR}/godot-cpp/gen/include/godot_cpp/classes/engine.hpp" ] || \
        [ ! -f "${CLANG_TIDY_BUILD_DIR}/godot-cpp/gen/include/godot_cpp/core/gdextension_interface_loader.hpp" ]; then
        echo "Style: configuring clang-tidy database..."
        cmake --log-level=ERROR -S "${ROOT_DIR}" -B "${CLANG_TIDY_BUILD_DIR}" \
            -DCMAKE_CXX_COMPILER=clang++ \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
            "-DLIBRELOADED_PLUGINS=${plugins}"
        cmake --build "${CLANG_TIDY_BUILD_DIR}" --target generate_bindings
    fi
}

is_supported_format_file() {
    [[ "$1" == *.cpp || "$1" == *.hpp || "$1" == *.h ]]
}

is_supported_tidy_file() {
    [[ "$1" == *.cpp || "$1" == *.cc || "$1" == *.cxx || "$1" == *.c || "$1" == *.hpp || "$1" == *.h ]]
}

is_header_tidy_file() {
    [[ "$1" == *.hpp || "$1" == *.h ]]
}

is_excluded_file() {
    [[ "$1" == */maszyna-mover/* || "$1" == "${ROOT_DIR}/src/gen/"* ]]
}

# The plugins built with the library (LIBRELOADED_PLUGINS, ;-separated, relative to this checkout
# or absolute): their files are checked as the core's, against the same configuration
plugin_dirs() {
    local plugins="${LIBRELOADED_PLUGINS:-}"
    local dir
    IFS=';' read -r -a dirs <<< "${plugins}"
    for dir in "${dirs[@]}"; do
        [ -n "${dir}" ] || continue
        (cd "${ROOT_DIR}" && realpath "${dir}")
    done
}

# Where the C++ sources are: the core's and each plugin's
source_dirs() {
    echo "${ROOT_DIR}/src"
    plugin_dirs
}

resolve_target_file() {
    local file="$1"

    if [ -f "${ROOT_DIR}/${file}" ]; then
        file="${ROOT_DIR}/${file}"
    fi

    if [ ! -f "${file}" ]; then
        echo "Style check: file not found: ${file}" >&2
        exit 1
    fi
    file="$(realpath "${file}")"

    if is_excluded_file "${file}"; then
        echo "Style check: file is excluded from style checks: ${file}" >&2
        exit 1
    fi

    if ! is_supported_format_file "${file}" && ! is_supported_tidy_file "${file}"; then
        echo "Style check: unsupported file type: ${file}" >&2
        exit 1
    fi

    echo "${file}"
}

run_clang_format() {
    if [ "$#" -eq 0 ]; then
        mapfile -t roots < <(source_dirs)
        find "${roots[@]}" \( -name "*.cpp" -or -name "*.hpp" -or -name "*.h" \) \
            -not -path "*/maszyna-mover/*" \
            -not -path "${ROOT_DIR}/src/gen/*" \
            -exec clang-format --dry-run --Werror --style=file:"${ROOT_DIR}/.clang-format" {} +
    elif is_supported_format_file "$1"; then
        clang-format --dry-run --Werror --style=file:"${ROOT_DIR}/.clang-format" "$1"
    fi
}

# Checks one file (an absolute path); a header through a source that includes it
run_clang_tidy() {
    local file="$1"
    local translation_unit="${file}"
    local header_filter_args=()

    if is_header_tidy_file "${file}"; then
        translation_unit=""

        for extension in cpp cc cxx c; do
            local candidate="${file%.*}.${extension}"
            if [ -f "${candidate}" ] && ! is_excluded_file "${candidate}"; then
                translation_unit="${candidate}"
                break
            fi
        done

        # a header without its own source is checked through a source that includes it, directly
        # or through another header; grep exits 1 when nothing matches and head closes the pipe
        # early - neither is a failure here, an empty result is checked below
        mapfile -t roots < <(source_dirs)
        local included="${file}"
        local visited=" "
        while [ -z "${translation_unit}" ] && [ -n "${included}" ] && [[ "${visited}" != *" ${included} "* ]]; do
            visited+="${included} "
            local pattern="#include [\"<].*$(basename "${included}")[\">]"
            translation_unit="$(
                grep -rl -m 1 --include='*.cpp' --include='*.cc' --include='*.cxx' --include='*.c' \
                    "${pattern}" "${roots[@]}" | head -n 1 || true
            )"
            included="$(grep -rl -m 1 --include='*.hpp' --include='*.h' "${pattern}" "${roots[@]}" | head -n 1 || true)"
        done

        if [ -z "${translation_unit}" ]; then
            echo "Style check: could not find translation unit for header: ${file}" >&2
            return 1
        fi

        header_filter_args=("-header-filter=${file}")
    fi

    (
        cd "${ROOT_DIR}"
        clang-tidy --quiet -p "${CLANG_TIDY_BUILD_DIR}" --config-file="${ROOT_DIR}/.clang-tidy" \
            "${header_filter_args[@]}" \
            -line-filter="[{\"name\":\"${file}\"}]" "${translation_unit}"
    )
}

if [ "$#" -gt 1 ]; then
    usage
    exit 1
fi

target_file=""
if [ "$#" -eq 1 ]; then
    target_file="$(resolve_target_file "$1")"
fi

ensure_compile_commands

echo "Style check: checking clang-format..."
if [ -n "${target_file}" ]; then
    run_clang_format "${target_file}"
else
    run_clang_format
fi

echo "Style check: checking clang-tidy..."
if [ -n "${target_file}" ]; then
    if is_supported_tidy_file "${target_file}"; then
        run_clang_tidy "${target_file}"
    fi
else
    # every file is checked on its own, so the whole tree runs in parallel, one job per core;
    # xargs exits non-zero when any file fails
    export ROOT_DIR CLANG_TIDY_BUILD_DIR LIBRELOADED_PLUGINS
    export -f run_clang_tidy is_header_tidy_file is_excluded_file plugin_dirs source_dirs
    mapfile -t roots < <(source_dirs)
    find "${roots[@]}" \( -name "*.cpp" -or -name "*.cc" -or -name "*.cxx" -or -name "*.c" -or -name "*.hpp" -or -name "*.h" \) \
        -not -path "*/maszyna-mover/*" \
        -not -path "${ROOT_DIR}/src/gen/*" |
        xargs -P "$(nproc)" -I{} bash -c 'set -euo pipefail; run_clang_tidy "$1"' _ {}
fi

echo "Style check: OK"
